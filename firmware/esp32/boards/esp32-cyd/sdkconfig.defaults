# ESP32-2432S028R "Cheap Yellow Display": ESP32-WROOM-32 (4 MB flash, no PSRAM),
# 2.8" ILI9341 320x240, XPT2046 touch, DAC speaker output, RGB LED, LDR.
# Pins: docs/hardware.md#esp32-2432s028r-cheap-yellow-display
CONFIG_IDF_TARGET="esp32"
# Flash stays at the base 4 MB; there is no PSRAM, so everything lives in the
# ~300 KB of internal heap (the display keeps a 160x120 framebuffer).
CONFIG_HG_BOARD_ESP32_CYD=y
# The classic ESP32 runs at 160 MHz by default; the UI and audio want 240.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Wi-Fi buffers sized for a no-PSRAM board with TLS and a WebSocket.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
